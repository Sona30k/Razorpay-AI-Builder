# Vercel: set MOCK_AI_MODE=true for deterministic demos, or use AI_PROVIDER=gemini
# with GEMINI_API_KEY. A Vercel function cannot access Ollama on your local computer.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MOCK_AI_MODE=false
MOCK_COMMERCE_MODE=false

# Optional Supabase persistence. Keep the service role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PERSISTENCE_SESSION_SECRET=

# Optional Razorpay test integration. Never use live-mode keys in this app.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_AMOUNT_PAISE=10000

# Optional verified company enrichment import. This is used only by scripts.
GOOGLE_PLACES_API_KEY=
