# Vercel deployment: set MOCK_AI_MODE=true and MOCK_COMMERCE_MODE=true.
# A Vercel function cannot access Ollama running on your local machine.
# Set MOCK_AI_MODE=false only when OLLAMA_BASE_URL points to a reachable hosted Ollama service.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MOCK_AI_MODE=false
MOCK_COMMERCE_MODE=false
